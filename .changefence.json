{
  "$schema": "https://raw.githubusercontent.com/nintechio/changefence/main/policy.schema.json",
  "max_files": 35,
  "max_additions": 3500,
  "max_deletions": 2500,
  "max_lines_per_file": 1200,
  "forbidden": [
    "python/dist/**",
    "htmlcov/**",
    "*.pem",
    "*.key",
    ".env"
  ],
  "protected": [
    ".changefence.json",
    ".github/workflows/**",
    ".github/dependabot.yml",
    "python/pyproject.toml",
    "schema/**",
    "SECURITY.md"
  ],
  "source_patterns": [
    "python/src/**",
    "rules/**"
  ],
  "test_patterns": [
    "python/tests/**"
  ],
  "require_tests_for_source": true,
  "allow_dependency_changes": false,
  "allow_binary_changes": false,
  "zones": [
    {
      "name": "rule-pack",
      "patterns": [
        "rules/**"
      ],
      "max_files": 15,
      "max_additions": 1000,
      "max_deletions": 500,
      "max_lines_per_file": 250
    }
  ]
}
