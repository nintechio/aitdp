{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitdp.dev/schema/0.1/threat-event.schema.json",
  "title": "AITDP Threat Event",
  "description": "A single detected threat against an LLM application or AI agent (AITDP spec v0.1).",
  "type": "object",
  "required": [
    "spec_version", "id", "timestamp", "category", "severity",
    "confidence", "stage", "title", "detector", "recommended_action"
  ],
  "properties": {
    "spec_version": { "type": "string", "const": "0.1" },
    "id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "category": {
      "type": "string",
      "enum": [
        "prompt_injection", "jailbreak", "sensitive_data_leak", "data_exfiltration",
        "tool_abuse", "excessive_agency", "insecure_output", "obfuscation",
        "supply_chain", "resource_abuse", "policy_violation", "other"
      ]
    },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stage": {
      "type": "string",
      "anyOf": [
        { "enum": ["system_prompt", "user_input", "retrieved_content", "tool_input", "tool_output", "model_output", "agent_message"] },
        { "pattern": "^x-[a-z0-9_-]+$" }
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string" },
    "detector": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "rule_id": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "excerpt": { "type": "string", "maxLength": 500 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "match": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "owasp_llm": { "type": "array", "items": { "type": "string", "pattern": "^LLM\\d{2}$" } },
        "mitre_atlas": { "type": "array", "items": { "type": "string", "pattern": "^AML\\.[A-Z]+\\d{4}(\\.\\d{3})?$" } },
        "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-\\d+$" } },
        "custom": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "recommended_action": { "type": "string", "enum": ["allow", "flag", "sanitize", "block", "require_human"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
